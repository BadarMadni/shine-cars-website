generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Booking {
  id            String   @id @default(cuid())
  name          String
  phone         String
  pickup        String
  dropoff       String
  date          String
  time          String
  distance      Float
  fare          Float
  vehicle       String   @default("car")
  status        String   @default("pending")
  source        String   @default("website")
  paymentMethod String   @default("cash")
  paymentStatus String   @default("unpaid")
  fareType      String   @default("fixed")
  meterDistance Float?
  meterFare     Float?
  customerId    String?
  driverId      String?
  stops         String?
  notes         String?
  isRecurring   Boolean  @default(false)
  recurringId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      Customer? @relation(fields: [customerId], references: [id])
  driver        Driver?   @relation(fields: [driverId], references: [id])
  recurring     RecurringBooking? @relation(fields: [recurringId], references: [id])
  invoiceItems  InvoiceItem[]

  @@index([status])
  @@index([createdAt])
  @@index([customerId])
  @@index([driverId])
  @@index([recurringId])
}

model Driver {
  id                String    @id @default(cuid())
  name              String
  phone             String
  vehicleMake       String?
  vehicleColor      String?
  bookings          Booking[]
  recurringBookings RecurringBooking[]
}

model Operator {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("operator")
  createdAt DateTime @default(now())
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  phone       String
  password    String
  accountType String    @default("individual")
  companyName String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]
  recurringBookings RecurringBooking[]
  invoices    Invoice[]

  @@index([accountType])
}

model RecurringBooking {
  id         String   @id @default(cuid())
  customerId String
  driverId   String?
  pickup     String
  dropoff    String
  stops      String?
  time       String
  vehicle    String   @default("car")
  fare       Float
  distance   Float
  days       String
  frequency  String   @default("weekly")
  startDate  String?
  endDate    String?
  driverStatus String?
  name       String
  phone      String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
  driver     Driver?  @relation(fields: [driverId], references: [id])
  bookings   Booking[]

  @@index([customerId])
  @@index([driverId])
  @@index([isActive])
}

model Invoice {
  id         String   @id @default(cuid())
  customerId String
  weekStart  String
  weekEnd    String
  total      Float    @default(0)
  status     String   @default("unpaid")
  stripeId   String?
  paidAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])
  items      InvoiceItem[]

  @@unique([customerId, weekStart])
  @@index([customerId])
  @@index([status])
}

model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  bookingId String
  fare      Float
  date      String
  pickup    String
  dropoff   String
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id])
  booking   Booking  @relation(fields: [bookingId], references: [id])

  @@index([invoiceId])
  @@index([bookingId])
}
